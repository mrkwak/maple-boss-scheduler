# 비밀 링크 키 (ADR-0008). 공유 링크: https://<앱 주소>/?k=<ACCESS_KEY>
ACCESS_KEY=

# 넥슨 Open API (서버 전용)
NEXON_API_KEY=

# Upstash Redis 저장소 (ADR-0011). Vercel에서 Redis를 연결하면 자동으로 들어옴
KV_REST_API_URL=
KV_REST_API_TOKEN=

# (대안) Google 스프레드시트 저장소 (ADR-0007). 둘 다 비우면 메모리 저장소(개발용)로 동작
SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# 환산 공급자 (ADR-0002): manual | maplescouter
# maplescouter는 운영자 허락과 조회 방식 확정 후에만 사용
SPEC_PROVIDER=manual
